<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions. Only documented false positives belong here. -->
<FindBugsFilter>
  <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring injects collaborators (ObjectMapper, JdbcClient, ...) through
       constructors on purpose; storing them is the design, not a leak of mutable state. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW: constructors validate configuration and fail fast on purpose (the application
       must not start with an invalid policy); the beans are never exposed to untrusted subclassing. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!-- Classes generated by protoc from contracts/grpc are not hand-written code. -->
  <Match>
    <Class name="~com\.coldguard\..*\.grpc\.v[0-9]+\..*"/>
  </Match>
</FindBugsFilter>
