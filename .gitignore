# Build output
target/
*.class

# Local secrets never commit real values
.env
.env.*
!.env.example
!deploy/local/.env.example

# Local mTLS development certificates — self-signed CA + leaf keys,
# regenerated on demand by deploy/scripts/generate-dev-certs.sh, never committed
deploy/local/certs/

# Terraform state and local overrides never committed
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Logs and generated PIDs
*.log
*.pid

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
