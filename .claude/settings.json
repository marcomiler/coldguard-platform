{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Revisando comando...' "
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(az:*)",
      "Bash(az deployment:*)",
      "Bash(docker compose -f deploy/azure/*)",
      "Bash(docker compose --file deploy/azure/*)",
      "Bash(docker compose -f *docker-compose.prod.yml*)",
      "Bash(docker compose -f *docker-compose.production.yml*)",
      "Bash(docker compose -p production*)",
      "Bash(docker compose --project-name production*)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -fr ..*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm:*)",
      "Bash(sudo rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git commit * docs/architecture/*)",
      "Bash(git commit * docs/domain/*)",
      "Bash(git commit * docs/architecture/adr/*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose -f deploy/local/*:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
