{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldguard.local/contracts/events/asset/SensorStatusChanged.v1.schema.json",
  "title": "SensorStatusChanged v1",
  "description": "A sensor operational status changed (manual or automatic).",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "SensorStatusChanged"
    },
    "eventVersion": {
      "const": 1
    },
    "producer": {
      "const": "asset-service"
    },
    "aggregateType": {
      "const": "Sensor"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sensorId": {
          "type": "string",
          "format": "uuid"
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "previousStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "IN_MAINTENANCE",
            "INACTIVE",
            "RETIRED"
          ]
        },
        "newStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "IN_MAINTENANCE",
            "INACTIVE",
            "RETIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "sensorId",
        "assetId",
        "previousStatus",
        "newStatus",
        "reason"
      ]
    }
  }
}
