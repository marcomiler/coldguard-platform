{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coldguard.local/contracts/events/incident/IncidentEscalated.v1.schema.json",
  "title": "IncidentEscalated v1",
  "description": "The Operations Supervisor escalated the incident (repeatable).",
  "allOf": [
    {
      "$ref": "../envelope.v1.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "IncidentEscalated"
    },
    "eventVersion": {
      "const": 1
    },
    "producer": {
      "const": "incident-service"
    },
    "aggregateType": {
      "const": "Incident"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "incidentId": {
          "type": "string",
          "format": "uuid"
        },
        "escalatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "escalationCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "incidentId",
        "escalatedAt",
        "reason",
        "priority",
        "escalationCount"
      ]
    }
  }
}
