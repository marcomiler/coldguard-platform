# ColdGuard local deployment environment variables.
# Copy to deploy/local/.env (never versioned) and fill in. Values below are local-development only.

# Database configuration (PostgreSQL, one instance, one logical schema per service)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# RabbitMQ configuration (broker credentials also used by every service that publishes/consumes)
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Password shared by the local demo users (one per role) created at startup. Local only; use a
# value of at least 8 characters. Compose refuses to start without it.
DEMO_USERS_PASSWORD=

# Address each demo user's notifications go to. Optional: empty keeps <username>@coldguard.local
# (visible only in Mailpit). Only the supervisor (incident created) and the technician (incident
# escalated) are notified. Applied when the user is created: after changing it, run
# deploy/scripts/reset-demo.sh so the users are created again.
# DEMO_SUPERVISOR_EMAIL=
# DEMO_TECHNICIAN_EMAIL=
# DEMO_ADMIN_EMAIL=

# Optional: forward the e-mails that go to real Gmail addresses through an external SMTP server so
# they can be checked in a real inbox (Mailpit keeps a copy of everything). For Gmail use an app
# password (Google account with 2-step verification), never the account password. up.sh enables the
# relay only when both USERNAME and PASSWORD are set.
# MAIL_RELAY_USERNAME=
# MAIL_RELAY_PASSWORD=
# MAIL_RELAY_HOST=smtp.gmail.com
# MAIL_RELAY_PORT=587

# Browser origins allowed to call the Gateway, comma-separated, explicit (no '*'), e.g. the
# frontend dev server URL. Leave empty to allow none.
# COLDGUARD_CORS_ALLOWED_ORIGINS=

# Demo only: how often the calibration expiry job runs (cron with seconds). Default: every 5 minutes.
# ASSET_CALIBRATION_EXPIRY_CRON=0 * * * * *

# Grafana configuration (only used with `--profile observability`)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# JVM tuning for every Java service container (optional; sensible defaults in docker-compose.yml)
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
# JAVA_SERVICE_MEM_LIMIT=768m
