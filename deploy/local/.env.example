# ColdGuard local deployment environment variables.
# Copy to deploy/local/.env (never versioned) and fill in. Values below are local-development only.

# Database configuration (PostgreSQL, one instance, one logical schema per service)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# RabbitMQ configuration (broker credentials also used by every service that publishes/consumes)
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Password shared by the local demo users (one per role) created at startup. Local only; use a
# value of at least 8 characters. Compose refuses to start without it.
DEMO_USERS_PASSWORD=

# Browser origins allowed to call the Gateway, comma-separated, explicit (no '*'), e.g. the
# frontend dev server URL. Leave empty to allow none.
# COLDGUARD_CORS_ALLOWED_ORIGINS=

# Grafana configuration (only used with `--profile observability`)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# JVM tuning for every Java service container (optional; sensible defaults in docker-compose.yml)
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
# JAVA_SERVICE_MEM_LIMIT=768m
