      "id": 30,
      "type": "timeseries",
      "title": "Messages handled per second by consumer service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, error) (rate(spring_rabbit_listener_seconds_count[1m]))",
          "legendFormat": "{{application}} {{error}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
