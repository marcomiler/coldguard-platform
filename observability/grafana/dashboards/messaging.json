    {
      "id": 19,
      "type": "timeseries",
      "title": "Parked events (need a human)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "coldguard_outbox_parked",
          "legendFormat": "{{application}}",
          "refId": "A"
