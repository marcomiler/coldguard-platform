    {
      "id": 20,
      "type": "timeseries",
      "title": "Published per second / failures per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(coldguard_outbox_published_total[1m]))",
          "legendFormat": "{{application}} published",
          "refId": "A"
