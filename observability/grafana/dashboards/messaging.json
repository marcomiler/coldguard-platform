        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(coldguard_outbox_publish_failures_total[1m]))",
          "legendFormat": "{{application}} failures",
          "refId": "B"
