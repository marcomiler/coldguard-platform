<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.coldguard</groupId>
    <artifactId>coldguard-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>incident-service</artifactId>

  <name>ColdGuard Incident Service</name>
  <description>Owns the Incident aggregate plus the internal Identity &amp; Access, Audit Log and operational-queries modules (DEC-004, DEC-005, DEC-006, DEC-008).</description>

  <!-- spring-boot-starter-web/-actuator/-validation and spring-boot-starter-test (test scope) are
       inherited from the root pom (all 5 modules need them). Only this module's own dependencies
       are declared below (ADR-006: this service owns the `incident`, `identity` and `auditlog`
       logical PostgreSQL schemas, DEC-008). -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
