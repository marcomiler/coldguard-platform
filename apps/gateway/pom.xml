<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.coldguard</groupId>
    <artifactId>coldguard-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>gateway</artifactId>

  <name>ColdGuard Gateway</name>
  <description>REST edge: JWT validation, routing to internal gRPC services, correlation/trace propagation.</description>

  <!-- grpc.version/protobuf.version resolved empirically via `mvn dependency:tree` against the
       spring-grpc-dependencies:1.0.3 BOM — not guessed, kept in sync with the BOM so
       the protoc/protoc-gen-grpc-java build-time plugins match the runtime library versions. -->
  <properties>
    <grpc.version>1.77.1</grpc.version>
    <protobuf.version>4.33.4</protobuf.version>
  </properties>

  <!-- spring-boot-starter-web/-actuator/-validation and spring-boot-starter-test (test scope) are
       inherited from the root pom (all 5 modules need them). Only this module's own dependencies
       are declared below (JWT validation is exclusive to the Gateway). -->
  <dependencyManagement>
    <dependencies>
      <!-- Spring gRPC BOM: supports Spring Boot 4.1.x per its own reference docs,
           verified before adoption. -->
      <dependency>
        <groupId>org.springframework.grpc</groupId>
        <artifactId>spring-grpc-dependencies</artifactId>
        <version>1.0.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- gRPC client only (Gateway calls IncidentService.CreateIncident); no server
         starter needed here (Gateway has no gRPC business logic of its own). -->
    <dependency>
      <groupId>org.springframework.grpc</groupId>
      <artifactId>spring-grpc-client-spring-boot-starter</artifactId>
    </dependency>
    <!-- In-process transport for testing the gRPC client adapter without a real server or
         network transport; version managed by the spring-grpc-dependencies BOM above. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 moved MVC test-slice support (@WebMvcTest, MockMvc autoconfiguration) out
         of spring-boot-test-autoconfigure into its own module; not covered by
         spring-boot-starter-test alone. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- Detects os.detected.classifier so protoc/protoc-gen-grpc-java download the right
           native executable for this machine (standard grpc-java Maven pattern). -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Compiles contracts/grpc/*.proto (shared monorepo source) into this
             module's own generated sources.-->
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${project.basedir}/../../contracts/grpc</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
