<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.coldguard</groupId>
    <artifactId>coldguard-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>gateway</artifactId>

  <name>ColdGuard Gateway</name>
  <description>REST edge: JWT validation, routing to internal gRPC services, correlation/trace propagation.</description>

  <!-- spring-boot-starter-web/-actuator/-validation and spring-boot-starter-test (test scope) are
       inherited from the root pom (all 5 modules need them). Only this module's own dependencies
       are declared below (JWT validation is exclusive to the Gateway). -->
  <dependencies>
    <dependency>
      <groupId>com.coldguard</groupId>
      <artifactId>coldguard-commons</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Used directly by main code (JwtConfig builds the signing key set) and by the test code that
         signs real RS256 JWTs. Version pinned to 10.9.1 to match the one resolved transitively via
         spring-security-oauth2-jose:7.1.1 (verified with `mvn dependency:tree`; not present in
         Spring Boot's own dependency-management BOM, so it can't be left unversioned like the other
         dependencies in this file). -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>10.9.1</version>
    </dependency>
    <!-- gRPC client only (Gateway calls IncidentService.CreateIncident); no server
         starter needed here (Gateway has no gRPC business logic of its own). -->
    <dependency>
      <groupId>org.springframework.grpc</groupId>
      <artifactId>spring-grpc-client-spring-boot-starter</artifactId>
    </dependency>
    <!-- Test-only: generates ephemeral CA + leaf certificates in memory for the mTLS handshake
         tests. The JDK has no public API to sign a leaf certificate with an
         arbitrary CA (only to parse existing certificates), so a certificate-generation library
         is strictly necessary; io.grpc:grpc-netty (already on the compile classpath transitively
         via spring-grpc-core) uses the JDK's own TLS provider, no additional Netty/TLS dependency
         needed. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>1.79</version>
      <scope>test</scope>
    </dependency>
    <!-- In-process transport for testing the gRPC client adapter without a real server or
         network transport; version managed by the spring-grpc-dependencies BOM above. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 moved MVC test-slice support (@WebMvcTest, MockMvc autoconfiguration) out
         of spring-boot-test-autoconfigure into its own module; not covered by
         spring-boot-starter-test alone. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
